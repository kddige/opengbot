{
  "name": "opengbot",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter @opengbot/desktop dev",
    "dev:daemon": "bun run --filter @opengbot/daemon dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12 <26"
  },
  "packageManager": "bun@1.4.0"
}
